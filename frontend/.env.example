# Address printed by: npm run deploy -- --network sepolia
NEXT_PUBLIC_CROWDFUNDING_ADDRESS=0x0000000000000000000000000000000000

# Alchemy Sepolia HTTPS endpoint used only for public read requests.
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Public IPFS gateway used to open evidence files from their CID.
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs

# Pinata JWT is server-only. Never use the NEXT_PUBLIC_ prefix or commit its value.
PINATA_JWT 
