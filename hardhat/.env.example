# Dán địa chỉ được in ra bởi `npm run deploy -- --network localhost`.
CROWDFUNDING_ADDRESS=0x0000000000000000000000000000000000000000

# Các giá trị tùy chọn cho script.
CAMPAIGN_ID=0
BENEFICIARY=0x0000000000000000000000000000000000000000
VERIFIER=0x0000000000000000000000000000000000000000
TARGET_ETH=1
DONATION_ETH=0.1
DEADLINE_SECONDS=3600
METADATA_ID=campaign-001
REQUEST_ETH=0.05
# CID IPFS của chứng từ. Script tự tính evidenceHash = keccak256(bytes(CID)).
EVIDENCE_CID=bafybeigdyrzt4evidence001
# 0 = tổ chức/creator, 1 = beneficiary, 2 = donor, 3 = verifier.
# Chỉ đổi ACCOUNT_INDEX khi cần chạy từ ví khác.
ACCOUNT_INDEX=0

# Chỉ bắt buộc khi deploy lên Sepolia. Đây là private key của ví deployer/creator,
# không phải địa chỉ ví công khai (private key có 0x + 64 ký tự hex).
SEPOLIA_RPC_URL=
SEPOLIA_CREATOR_PRIVATE_KEY=
